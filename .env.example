# --- Supabase (Project Settings → API) ---
# Leave empty to run in DEMO MODE with the built-in seed issue (no database, sign-ups are not stored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Link for "Αγορά εισιτηρίων" on the back page (opens in a new tab)
NEXT_PUBLIC_TICKETS_URL=https://www.more.com

# --- Email platform (optional) ---
# When set, /api/subscribe forwards each sign-up to the provider adapter in lib/email.ts.
# Supported values: webhook
EMAIL_PROVIDER=
EMAIL_WEBHOOK_URL=

# --- Background removal for cover cut-outs (optional) ---
# remove.bg API key. Without it, upload a ready-made transparent PNG cut-out.
REMOVE_BG_API_KEY=
